# Copy this file to `.env` and fill in your robot's values, then run any example.
#   cp .env.example .env
#
# Get the URL and token from the robot UI:
#   <robot name>  ->  Configure Developer API  ->  enable the API  ->  copy the
#   Authorization Token. The token is specific to that robot.

# Cloud address for your controller (replace cb1234 with your serial),
# or http://<robot-ip>:3000 on the LAN, or http://localhost:3000 on the controller.
ROBOT_URL=https://cb1234.sb.app

# Authorization Token from Configure Developer API.
ROBOT_TOKEN=your-api-token-here

# "simulated" (default, safe) or "live". You can also pass --live on the CLI.
# NOTE: the examples default to simulated even if this is unset.
ROBOT_KIND=simulated
